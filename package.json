      "minimatch": ">=10.2.3",
      "rollup": ">=4.59.0",
      "serialize-javascript": ">=7.0.3",
      "hono": ">=4.12.4",
      "@hono/node-server": ">=1.19.10",
      "express-rate-limit": ">=8.2.2",
      "flatted": ">=3.4.2",
      "undici": ">=7.24.0"
    }
  }

{
  "name": "unicon",
  "version": "0.1.0",
  "description": "Just the icons you need. Zero bloat. Browse 20,000+ icons and copy exactly what you need.",
  "private": false,
  "license": "MIT",
  "author": "WebRenew (https://webrenew.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/WebRenew/unicon.git"
  },
  "homepage": "https://unicon.sh",
  "bugs": {
    "url": "https://github.com/WebRenew/unicon/issues"
  },
  "keywords": [
    "icons",
    "react",
    "svg",
    "nextjs",
    "typescript",
    "developer-tools",
    "icon-library",
    "lucide",
    "heroicons",
    "phosphor",
    "shadcn"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "embeddings": "tsx scripts/generate-embeddings.ts",
    "embeddings:stats": "tsx scripts/generate-embeddings.ts --stats",
    "cache:warm": "tsx scripts/warm-cache.ts",
    "cache:warm:prod": "tsx scripts/warm-cache.ts --url=https://unicon.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.37",
    "@ai-sdk/openai": "^3.0.25",
    "@libsql/client": "^0.17.2",
